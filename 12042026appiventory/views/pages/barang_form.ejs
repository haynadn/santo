<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/sidebar', { currentPath: '/barang', currentKategori: kategori }) %>
<div class="main" id="main">
  <%- include('../partials/topbar', {
    pageTitle: barang ? 'Edit Barang' : 'Tambah Barang',
    pageSubtitle: `Kategori: ${kategori}`,
    actions: `<a href="/barang?kategori=${kategori}" class="btn btn-ghost btn-sm">← Kembali</a>`
  }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div style="max-width:780px;">
      <div class="card">
        <div class="card-header">
          <div class="card-title"><%= barang ? '✏ Edit Data Barang' : '+ Tambah Barang Baru' %></div>
          <span class="badge badge-blue"><%= kategori %></span>
        </div>
        <div class="card-body">
          <form method="POST" action="<%= barang ? `/barang/${barang.id}?_method=PUT` : '/barang' %>">

            <div class="form-group">
              <label>Kategori</label>
              <select name="kategori" class="form-control" onchange="window.location.href='/barang/tambah?kategori='+this.value">
                <% ['ALKES','ATK','ART','ALSINTOR','ALSATRI','ALKOMLEK','BANGFAS'].forEach(k => { %>
                <option value="<%= k %>" <%= k === kategori ? 'selected' : '' %>><%= k %></option>
                <% }) %>
              </select>
            </div>

            <div class="section-label blue">Informasi Dasar</div>
            <div class="grid grid-2">
              <div class="form-group">
                <label>Tanggal *</label>
                <input type="date" name="tanggal" class="form-control" required
                       value="<%= barang && barang.tanggal ? new Date(barang.tanggal).toISOString().split('T')[0] : '' %>">
              </div>
              <div class="form-group">
                <label>Kode Barang</label>
                <input type="text" name="kode_barang" class="form-control" placeholder="cth: BKS-001"
                       value="<%= barang ? barang.kode_barang || '' : '' %>">
              </div>
            </div>

            <div class="form-group">
              <label>Nama Barang *</label>
              <input type="text" name="nama_barang" class="form-control" required placeholder="Nama lengkap barang"
                     value="<%= barang ? barang.nama_barang || '' : '' %>">
            </div>

            <div class="form-group">
              <label>Merk / Type Barang</label>
              <input type="text" name="merk_type" class="form-control" placeholder="cth: Samsung, Philips, dll"
                     value="<%= barang ? barang.merk_type || '' : '' %>">
            </div>

            <div class="grid grid-2">
              <div class="form-group">
                <label>Satuan</label>
                <input type="text" name="satuan" class="form-control" placeholder="pcs / unit / box"
                       value="<%= barang ? barang.satuan || '' : '' %>">
              </div>
              <div class="form-group">
                <label>Kondisi</label>
                <select name="kondisi" class="form-control">
                  <option value="">-- Pilih Kondisi --</option>
                  <% ['Baik','Rusak Ringan','Rusak Berat','Tidak Beroperasi'].forEach(k => { %>
                  <option value="<%= k %>" <%= barang && barang.kondisi === k ? 'selected' : '' %>><%= k %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="grid grid-2">
              <div class="form-group">
                <label>Sumber Pendanaan</label>
                <select name="sumber_pendanaan" class="form-control">
                  <option value="">-- Pilih Sumber --</option>
                  <% ['Kemhan','Kesdam','Swakelola','DIPA PNBP RS'].forEach(s => { %>
                  <option value="<%= s %>" <%= barang && barang.sumber_pendanaan === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label>Posisi Barang di Ruangan</label>
                <input type="text" name="posisi_ruangan" class="form-control" placeholder="cth: Gudang A, Ruang B"
                       value="<%= barang ? barang.posisi_ruangan || '' : '' %>">
              </div>
            </div>

            <div class="form-group">
              <label>Nama Penerima Barang</label>
              <input type="text" name="nama_penerima" class="form-control" placeholder="Nama penerima barang"
                     value="<%= barang ? barang.nama_penerima || '' : '' %>">
            </div>

            <div class="section-label green">Data Stok & Harga</div>
            <div class="grid grid-2 mb-4">
              <div class="form-group">
                <label>Jumlah / Stok *</label>
                <input type="number" name="jumlah" class="form-control" min="0" required
                       value="<%= barang ? barang.stok_akhir : 0 %>" placeholder="0">
              </div>
              <div class="form-group">
                <label>Harga Satuan (Rp)</label>
                <input type="number" name="harga" class="form-control" min="0" step="0.01"
                       value="<%= barang ? barang.harga : 0 %>" placeholder="0">
              </div>
            </div>

            <div class="form-group">
              <label>Supplier</label>
              <input type="text" name="supplier" class="form-control" placeholder="Nama supplier/vendor"
                     value="<%= barang ? barang.supplier || '' : '' %>">
            </div>

            <!-- EXTRA FIELDS per kategori -->
            <% if (extraFields.includes('expired')) { %>
            <div class="form-group">
              <label>Tanggal Expired</label>
              <input type="date" name="expired" class="form-control"
                     value="<%= barang && barang.expired ? new Date(barang.expired).toISOString().split('T')[0] : '' %>">
            </div>
            <% } %>

            <% if (extraFields.includes('lokasi')) { %>
            <div class="form-group">
              <label>Lokasi Detail</label>
              <input type="text" name="lokasi" class="form-control" placeholder="Lokasi penyimpanan detail"
                     value="<%= barang ? barang.lokasi || '' : '' %>">
            </div>
            <% } %>

            <% if (extraFields.includes('status')) { %>
            <div class="form-group">
              <label>Status</label>
              <select name="status" class="form-control">
                <option value="">-- Pilih Status --</option>
                <% ['Aktif','Tidak Aktif','Dalam Pemeliharaan','Rusak'].forEach(s => { %>
                <option value="<%= s %>" <%= barang && barang.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
            <% } %>

            <% if (extraFields.includes('tgl_pemeliharaan')) { %>
            <div class="form-group">
              <label>Tanggal Pemeliharaan</label>
              <input type="date" name="tgl_pemeliharaan" class="form-control"
                     value="<%= barang && barang.tgl_pemeliharaan ? new Date(barang.tgl_pemeliharaan).toISOString().split('T')[0] : '' %>">
            </div>
            <% } %>

            <% if (extraFields.includes('pj')) { %>
            <div class="form-group">
              <label>Penanggung Jawab (PJ)</label>
              <input type="text" name="pj" class="form-control" placeholder="Nama PJ"
                     value="<%= barang ? barang.pj || '' : '' %>">
            </div>
            <% } %>

            <% if (extraFields.includes('nrp_nip')) { %>
            <div class="grid grid-2">
              <div class="form-group">
                <label>NRP/NIP</label>
                <input type="text" name="nrp_nip" class="form-control" value="<%= barang ? barang.nrp_nip || '' : '' %>">
              </div>
              <div class="form-group">
                <label>Unit</label>
                <input type="text" name="unit" class="form-control" value="<%= barang ? barang.unit || '' : '' %>">
              </div>
            </div>
            <% } %>

            <% if (extraFields.includes('ket')) { %>
            <div class="form-group">
              <label>Keterangan</label>
              <textarea name="ket" class="form-control" rows="3" placeholder="Catatan tambahan..."><%= barang ? barang.ket || '' : '' %></textarea>
            </div>
            <% } %>

            <div class="flex gap-3 mt-4">
              <button type="submit" class="btn btn-primary">
                <%= barang ? '💾 Simpan Perubahan' : '+ Tambah Barang' %>
              </button>
              <a href="/barang?kategori=<%= kategori %>" class="btn btn-ghost">Batal</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</div>

<script>
// Logic hitung otomatis dihapus karena sekarang hanya input Jumlah langsung
</script>
<%- include('../partials/scripts') %>
</body>
</html>
