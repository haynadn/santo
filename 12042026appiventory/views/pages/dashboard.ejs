<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — Departemen Inventaris</title>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/sidebar', { currentPath: '/', currentKategori: '' }) %>
<div class="main" id="main">
  <%- include('../partials/topbar', {
    pageTitle: 'Dashboard',
    pageSubtitle: 'Ringkasan stok seluruh kategori barang',
    actions: `<span style="font-size:12px;color:#6b7280;background:#f3f4f6;padding:6px 14px;border-radius:20px;">📅 ${new Date().toLocaleDateString('id-ID',{weekday:'short',year:'numeric',month:'short',day:'numeric'})}</span>`
  }) %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <% let totalItem=0, totalStok=0;
       kategoriList.forEach(k => { totalItem += stats[k]?.total_item||0; totalStok += stats[k]?.total_stok||0; }); %>

    <!-- STAT CARDS -->
    <div class="grid grid-4 mb-6">
      <div class="stat-card grad-blue">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24"><path d="M3 3h18M3 9h18M3 15h18"/></svg></div>
        <div class="stat-label">Total Kategori</div>
        <div class="stat-value">8</div>
        <div class="stat-sub">Jenis kelompok barang</div>
      </div>
      <div class="stat-card grad-green">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/></svg></div>
        <div class="stat-label">Total Entri</div>
        <div class="stat-value"><%= totalItem %></div>
        <div class="stat-sub">Data barang tercatat</div>
      </div>
      <div class="stat-card grad-orange">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24"><path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8"/></svg></div>
        <div class="stat-label">Total Stok</div>
        <div class="stat-value"><%= totalStok %></div>
        <div class="stat-sub">Unit barang tersisa</div>
      </div>
      <div class="stat-card grad-purple">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <div class="stat-label">Status</div>
        <div class="stat-value" style="font-size:18px;margin-top:6px;">● Online</div>
        <div class="stat-sub">Sistem aktif</div>
      </div>
    </div>

    <!-- CHARTS -->
    <div class="grid grid-2 mb-6">
      <div class="card">
        <div class="card-header">
          <div class="card-title">Stok per Kategori</div>
          <span class="badge badge-blue">Bar Chart</span>
        </div>
        <div class="card-body">
          <canvas id="chartStok" height="220"></canvas>
        </div>
      </div>
      <div class="card">
        <div class="card-header">
          <div class="card-title">Distribusi Barang</div>
          <span class="badge badge-green">Doughnut</span>
        </div>
        <div class="card-body">
          <canvas id="chartDist" height="220"></canvas>
        </div>
      </div>
    </div>

    <div class="card mb-6">
      <div class="card-header">
        <div class="card-title">Masuk vs Keluar per Kategori</div>
        <span class="badge badge-yellow">Perbandingan</span>
      </div>
      <div class="card-body">
        <canvas id="chartMK" height="110"></canvas>
      </div>
    </div>

    <!-- CATEGORY MINI CARDS -->
    <div style="font-size:13px;font-weight:700;color:#374151;margin-bottom:14px;">Detail per Kategori</div>
    <div class="grid grid-4 mb-6">
      <% const grads = ['grad-blue','grad-green','grad-orange','grad-purple','grad-cyan','grad-pink','grad-red','grad-indigo']; %>
      <% kategoriList.forEach((kat, i) => { const s = stats[kat] || {}; %>
      <a href="/barang?kategori=<%= kat %>" style="text-decoration:none;">
        <div class="card" style="cursor:pointer;transition:transform 0.15s,box-shadow 0.15s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="card-body" style="padding:16px !important;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
              <div style="width:8px;height:8px;border-radius:50%;background:var(--primary);"></div>
              <div style="font-size:12px;font-weight:700;color:#374151;"><%= kat %></div>
            </div>
            <div style="font-size:26px;font-weight:800;color:#111827;line-height:1;"><%= s.total_stok||0 %></div>
            <div style="font-size:11px;color:#9ca3af;margin-top:4px;"><%= s.total_item||0 %> entri</div>
            <div style="margin-top:10px;display:flex;gap:10px;font-size:11px;">
              <span style="color:#10b981;">↑ <%= s.total_masuk||0 %></span>
              <span style="color:#ef4444;">↓ <%= s.total_keluar||0 %></span>
            </div>
          </div>
        </div>
      </a>
      <% }) %>
    </div>

    <!-- RECENT TABLE -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">Entri Data Terbaru</div>
        <span class="badge badge-gray">10 Terakhir</span>
      </div>
      <% if (recent.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tanggal</th>
              <th>Kategori</th>
              <th>Nama Barang</th>
              <th>Stok Awal</th>
              <th>Masuk</th>
              <th>Keluar</th>
              <th>Stok Akhir</th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(b => { %>
            <tr>
              <td style="color:#6b7280;font-size:12px;"><%= b.tanggal ? new Date(b.tanggal).toLocaleDateString('id-ID') : '-' %></td>
              <td><span class="badge badge-blue"><%= b.kategori %></span></td>
              <td style="font-weight:600;"><%= b.nama_barang %></td>
              <td><%= b.stok_awal %></td>
              <td><span class="badge badge-green">+<%= b.masuk %></span></td>
              <td><span class="badge badge-red">-<%= b.keluar %></span></td>
              <td style="font-weight:700;"><%= b.stok_akhir %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div style="text-align:center;padding:48px;color:#9ca3af;">
        <div style="font-size:40px;margin-bottom:12px;">📦</div>
        <div>Belum ada data. Jalankan <code>npm run seed</code></div>
      </div>
      <% } %>
    </div>
  </div>
  <%- include('../partials/footer') %>
</div>

<script>
const labels = <%- JSON.stringify(kategoriList) %>;
const stats = <%- JSON.stringify(stats) %>;
const stokData = labels.map(k => stats[k]?.total_stok||0);
const masukData = labels.map(k => stats[k]?.total_masuk||0);
const kelData = labels.map(k => stats[k]?.total_keluar||0);
const colors = ['#6366f1','#10b981','#f59e0b','#8b5cf6','#06b6d4','#ec4899','#ef4444','#6366f1'];

Chart.defaults.font.family = 'Inter, sans-serif';
Chart.defaults.color = '#9ca3af';

new Chart(document.getElementById('chartStok'), {
  type: 'bar',
  data: { labels, datasets: [{ label: 'Stok Akhir', data: stokData, backgroundColor: colors.map(c=>c+'33'), borderColor: colors, borderWidth: 2, borderRadius: 6 }] },
  options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { color: '#f3f4f6' }, beginAtZero: true } } }
});

new Chart(document.getElementById('chartDist'), {
  type: 'doughnut',
  data: { labels, datasets: [{ data: stokData, backgroundColor: colors.map(c=>c+'cc'), borderColor: '#fff', borderWidth: 3 }] },
  options: { responsive: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 10, usePointStyle: true } } }, cutout: '68%' }
});

new Chart(document.getElementById('chartMK'), {
  type: 'bar',
  data: { labels, datasets: [
    { label: 'Masuk', data: masukData, backgroundColor: '#10b98133', borderColor: '#10b981', borderWidth: 2, borderRadius: 5 },
    { label: 'Keluar', data: kelData, backgroundColor: '#ef444433', borderColor: '#ef4444', borderWidth: 2, borderRadius: 5 },
  ]},
  options: { responsive: true, plugins: { legend: { position: 'top', labels: { usePointStyle: true, font: { size: 12 } } } }, scales: { x: { grid: { display: false } }, y: { grid: { color: '#f3f4f6' }, beginAtZero: true } } }
});
</script>
<%- include('../partials/scripts') %>
</body>
</html>
