<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login — Departemen Inventaris</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Inter', sans-serif; height: 100vh; display: flex; overflow: hidden; }

/* LEFT PANEL */
.left-panel {
  flex: 1; background: linear-gradient(135deg, #6d28d9 0%, #7c3aed 40%, #8b5cf6 100%);
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 40px; position: relative; overflow: hidden;
}
.left-panel::before {
  content: '';
  position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='600' height='600' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='rgba(255,255,255,0.08)' stroke-width='1'%3E%3Cpath d='M300 0 L600 300 L300 600 L0 300 Z'/%3E%3Cpath d='M300 50 L550 300 L300 550 L50 300 Z'/%3E%3Cpath d='M300 100 L500 300 L300 500 L100 300 Z'/%3E%3Cpath d='M300 150 L450 300 L300 450 L150 300 Z'/%3E%3Cpath d='M300 200 L400 300 L300 400 L200 300 Z'/%3E%3C/g%3E%3C/svg%3E") center/cover;
  opacity: 0.6;
}
/* Mesh gradient orbs */
.left-panel::after {
  content: '';
  position: absolute;
  width: 400px; height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(167,139,250,0.35) 0%, transparent 70%);
  top: -100px; right: -100px;
}
.orb2 {
  position: absolute;
  width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, rgba(139,92,246,0.3) 0%, transparent 70%);
  bottom: -50px; left: -50px;
}

.left-brand {
  position: relative; z-index: 1;
}
.left-brand .logo {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 0;
}
.left-brand .logo-icon {
  width: 38px; height: 38px; border-radius: 10px;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(8px);
}
.left-brand .logo-icon svg { width: 20px; height: 20px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.left-brand .logo-text { font-size: 17px; font-weight: 800; color: #fff; }

.left-content { position: relative; z-index: 1; }
.left-content h1 { font-size: 32px; font-weight: 800; color: #fff; line-height: 1.25; margin-bottom: 16px; }
.left-content p { font-size: 14px; color: rgba(255,255,255,0.75); line-height: 1.7; max-width: 380px; }

.left-links {
  position: relative; z-index: 1;
  display: flex; gap: 24px;
}
.left-links a { font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s; }
.left-links a:hover { color: #fff; }

/* RIGHT PANEL */
.right-panel {
  width: 480px; background: #111827;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 48px 52px;
}

.login-heading { text-align: center; margin-bottom: 36px; }
.login-heading h2 { font-size: 22px; font-weight: 800; color: #f9fafb; margin-bottom: 6px; }
.login-heading p { font-size: 13px; color: #6b7280; }

.form-group { margin-bottom: 18px; width: 100%; }
.form-group label { display: block; font-size: 12px; font-weight: 600; color: #9ca3af; margin-bottom: 7px; }
.form-control {
  width: 100%; padding: 11px 14px;
  background: #1f2937; border: 1.5px solid #374151;
  border-radius: 9px; color: #f9fafb; font-size: 14px;
  font-family: 'Inter', sans-serif; outline: none;
  transition: border-color 0.15s;
}
.form-control:focus { border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124,58,237,0.15); }
.form-control::placeholder { color: #4b5563; }

.btn-login {
  width: 100%; padding: 12px;
  background: linear-gradient(135deg, #7c3aed, #6366f1);
  color: #fff; border: none; border-radius: 9px;
  font-size: 14px; font-weight: 700; cursor: pointer;
  font-family: 'Inter', sans-serif;
  transition: opacity 0.15s; margin-top: 4px;
  box-shadow: 0 4px 12px rgba(124,58,237,0.35);
}
.btn-login:hover { opacity: 0.9; }

.divider {
  display: flex; align-items: center; gap: 14px;
  margin: 24px 0; width: 100%;
}
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #1f2937; }
.divider span { font-size: 12px; color: #4b5563; }

.alert {
  width: 100%; padding: 11px 14px; border-radius: 8px;
  background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2);
  color: #f87171; font-size: 13px; font-weight: 500; margin-bottom: 20px;
}

.hint-box {
  width: 100%; margin-top: 24px; padding: 14px;
  background: rgba(255,255,255,0.03); border: 1px solid #1f2937;
  border-radius: 9px; text-align: center;
}
.hint-box p { font-size: 12px; color: #4b5563; margin-bottom: 6px; }
.hint-box code { background: #1f2937; color: #a78bfa; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }

@media (max-width: 768px) {
  .left-panel { display: none; }
  .right-panel { width: 100%; padding: 32px 24px; }
}
</style>
</head>
<body>

<!-- LEFT PANEL -->
<div class="left-panel">
  <div class="orb2"></div>
  <div class="left-brand">
    <div class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
      </div>
      <span class="logo-text">Departemen Inventaris</span>
    </div>
  </div>
  <div class="left-content">
    <h1>Sistem Pendataan<br>Barang Masuk &<br>Keluar</h1>
    <p>Platform manajemen inventaris terpadu untuk pendataan, monitoring stok, dan pelaporan barang secara real-time.</p>
  </div>
  <div class="left-links">
    <a href="#">Tentang Sistem</a>
    <a href="#">Panduan</a>
    <a href="#">Kontak</a>
  </div>
</div>

<!-- RIGHT PANEL -->
<div class="right-panel">
  <div class="login-heading">
    <h2>Masuk ke Akun Anda</h2>
    <p>Gunakan kredensial yang telah diberikan</p>
  </div>

  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <% error.forEach(msg => { %>
      <div class="alert">⚠ <%= msg %></div>
    <% }) %>
  <% } %>

  <form method="POST" action="/auth/login" style="width:100%">
    <div class="form-group">
      <label>Username</label>
      <input class="form-control" type="text" name="username" placeholder="Masukkan username" required autofocus>
    </div>
    <div class="form-group">
      <label>Password</label>
      <input class="form-control" type="password" name="password" placeholder="Masukkan password" required>
    </div>
    <button type="submit" class="btn-login">Masuk →</button>
  </form>

  <div class="hint-box">
    <p>Akun default untuk pertama kali masuk:</p>
    <code>admin</code> &nbsp;/&nbsp; <code>admin123</code>
  </div>
</div>

</body>
</html>
